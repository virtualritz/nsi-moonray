/target
/tools/footprint/target
/tools/scalar-material/build
/tools/osl-probe/build
/dso/osl/build
/dso/meshlight/build

# Test renders. `tests/render.rs` names its own output and
# `SceneVariables` writes `scene.exr` beside whatever ran a render, so
# both land here and neither is worth keeping.
/scene.exr
/unused.exr

# Assembled bundles and the installers made from them (`just bundle`,
# `just package`).
/dist/

# MoonRay, fetched and built by `just renderer`. Not a submodule: four
# repositories and several hundred megabytes, useless to anyone who
# wants the emitter and the flush.
/vendor/

# The conda environment `just pixi-install` resolves. `pixi.toml` and
# `pixi.lock` are committed; what they resolve to is not.
/.pixi/
